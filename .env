 # Point this at the real backend. Must include the /api prefix — every
# backend route is registered under /api/... (see backend/src/app.ts).
VITE_API_BASE_URL=http://localhost:5000/api

# Set to "false" now that the backend above is reachable and the endpoints
# documented in README.md exist. While "true", every screen runs off an
# in-memory mock store so the UI is fully clickable with no backend.
VITE_USE_MOCK=false
